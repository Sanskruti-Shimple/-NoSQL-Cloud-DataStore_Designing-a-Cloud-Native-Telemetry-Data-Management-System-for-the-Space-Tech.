APP_ENV=development
JWT_SECRET=replace-this-development-secret-with-at-least-32-characters
TOKEN_TTL_MINUTES=30
MISSION_USERNAME=mission-operator
MISSION_PASSWORD=change-this-local-development-password
SCIENTIST_USERNAME=scientist
SCIENTIST_PASSWORD=change-this-scientist-development-password
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=telemetry.v1
# Set both SASL variables when connecting to Azure Event Hubs or another SASL-enabled Kafka cluster.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=mission_control
REDIS_URL=redis://localhost:6379/0
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=mission_telemetry
# Leave these empty for the local unauthenticated Cassandra container.
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_CA_FILE=
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=local-neo4j-password
RATE_LIMIT_PER_MINUTE=120
MAX_HISTORY_DAYS=31
